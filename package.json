{
	"name": "telegram-agent-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./store/memory": {
			"bun": "./src/store/memory.ts",
			"types": "./dist/store/memory.d.ts",
			"default": "./dist/store/memory.js"
		},
		"./store/file": {
			"bun": "./src/store/file.ts",
			"types": "./dist/store/file.d.ts",
			"default": "./dist/store/file.js"
		},
		"./telegram": {
			"bun": "./src/telegram/index.ts",
			"types": "./dist/telegram/index.d.ts",
			"default": "./dist/telegram/index.js"
		},
		"./grammy": {
			"bun": "./src/grammy/index.ts",
			"types": "./dist/grammy/index.d.ts",
			"default": "./dist/grammy/index.js"
		},
		"./files": {
			"bun": "./src/files/index.ts",
			"types": "./dist/files/index.d.ts",
			"default": "./dist/files/index.js"
		},
		"./view": {
			"bun": "./src/view/index.ts",
			"types": "./dist/view/index.d.ts",
			"default": "./dist/view/index.js"
		},
		"./view/handler": {
			"bun": "./src/view/handler.ts",
			"types": "./dist/view/handler.d.ts",
			"default": "./dist/view/handler.js"
		},
		"./worker": {
			"bun": "./src/worker/index.ts",
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./commands": {
			"bun": "./src/commands/index.ts",
			"types": "./dist/commands/index.d.ts",
			"default": "./dist/commands/index.js"
		},
		"./mcp": {
			"bun": "./src/mcp/index.ts",
			"types": "./dist/mcp/index.d.ts",
			"default": "./dist/mcp/index.js"
		},
		"./testing": {
			"bun": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"bin": {
		"telegram-agent-ui": "./dist/cli/bin.js"
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "bun test",
		"test:browser": "bun test ./src/view/shell.browser.ts",
		"test:node": "rm -rf dist && tsc -p tsconfig.build.json && ${NODE:-node} scripts/node-entries.mjs",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
	},
	"dependencies": {
		"@grammyjs/types": "5.0.0",
		"@modelcontextprotocol/server": "2.4.0",
		"smol-toml": "1.9.1"
	},
	"peerDependencies": {
		"grammy": "^1.46.0"
	},
	"peerDependenciesMeta": {
		"grammy": {
			"optional": true
		}
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.4.0",
		"@types/bun": "1.4.4",
		"@types/node": "26.6.6",
		"fast-check": "4.10.2",
		"grammy": "1.46.0",
		"happy-dom": "21.0.4",
		"playwright-core": "1.65.0",
		"typescript": "7.0.2"
	}
}
