{
	"name": "telegram-agent-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./store/memory": {
			"bun": "./src/store/memory.ts",
			"types": "./dist/store/memory.d.ts",
			"default": "./dist/store/memory.js"
		},
		"./testing": {
			"bun": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "bun test",
		"test:node": "rm -rf dist && tsc -p tsconfig.build.json && ${NODE:-node} scripts/node-entries.mjs",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@grammyjs/types": "5.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"fast-check": "4.10.2",
		"typescript": "7.0.2"
	}
}
