{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"lib": ["ES2023", "DOM"],
		"types": ["node"]
	},
	"include": [
		"src/index.ts",
		"src/store/memory.ts",
		"src/store/file.ts",
		"src/telegram/index.ts",
		"src/grammy/index.ts",
		"src/files/index.ts",
		"src/view/index.ts",
		"src/view/handler.ts",
		"src/worker/index.ts",
		"src/commands/index.ts",
		"src/commands/supervise.ts",
		"src/mcp/index.ts",
		"src/cli/bin.ts",
		"src/testing/index.ts"
	]
}
